# Copy to .env and fill in. Quote a value with single quotes if it contains $ or spaces.

# The domain the launcher is reached at (its DNS must point at this machine).
DOMAIN=launcher.example.com

# The administrator signs in at https://<DOMAIN>/admin/ with these to install, update and remove
# apps. Everyone else can only open the installed apps. At least 8 characters.
ARTCRAFT_ADMIN_USER=admin
ARTCRAFT_ADMIN_PASSWORD='change-me-to-something-long'

# How often the server looks for new releases, in minutes.
ARTCRAFT_CHECK_MINUTES=30

# Optional GitHub token (no scopes needed): 5000 GitHub API requests an hour instead of 60.
ARTCRAFT_LAUNCHER_GITHUB_TOKEN=
